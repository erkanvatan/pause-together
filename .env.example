# Production settings. Copy to .env. Dev reads only MEDIA_ROOT from it.

# Host IP for the guest port. Set it to this machine's Tailscale IP to let guests in.
# Never 0.0.0.0: Docker bypasses ufw, so that opens the port on every network (café Wi-Fi too).
PUBLIC_BIND=127.0.0.1

# Host ports. 8080 and 8081 are only the ports inside the container.
GUEST_PORT=8420
ADMIN_PORT=8421

# Host folder for the database, backups and (later) the video cache. Mounted at /data.
# task up creates it, owned by you.
DATA_DIR=~/.local/share/pausetogether

# Host folder holding all your media. Mounted read-only at /media; libraries are folders inside it.
# Dev mounts it too, and every task that uses Docker (dev, test, lint) needs it set.
MEDIA_ROOT=~/Videos
